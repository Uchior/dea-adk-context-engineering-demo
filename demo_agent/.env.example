GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
AGENT_ENGINE_ID=

# GCPリソースのリージョン（BQ接続・データセット・GCS等）
GCP_REGION=us

# Dataform（us-central1 固定）
DATAFORM_LOCATION=us-central1
DATAFORM_REPO=dea-pipeline-repo
DATAFORM_WORKSPACE=dea-workspace

# BigQuery
BQ_DATASET=alphabet_reports
BQ_CONNECTION_ID=ai-connection

# GCS
GCS_BUCKET=alphabet-reports-your-project-id

# Document AI
DOCAI_PROCESSOR=projects/YOUR_PROJECT_NUMBER/locations/us/processors/YOUR_PROCESSOR_ID
